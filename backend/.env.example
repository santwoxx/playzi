PORT=5000
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-firebase-client-email
# Note: Keep the private key format intact, including wrapping in quotes if it contains newlines.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Gemini (moderation and AI insights). Server-side only: never put this key in the frontend.
GEMINI_API_KEY=
# Optional: override the Gemini model (default: gemini-3-flash-preview)
# GEMINI_MODEL=
