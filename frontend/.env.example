# Firebase Configuration
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_VAPID_KEY=your-firebase-vapid-key

# Agora SDK Configuration (for voice/video chat)
VITE_AGORA_APP_ID=your-agora-app-id

# YouTube Data API Configuration
VITE_YOUTUBE_API_KEY=your-youtube-api-key

# Backend API URL (Optional: defaults to /api proxying if not specified)
# Useful if you prefer direct API connection to Render instead of routing via Vercel proxy.
VITE_API_URL=https://playzi-backend.onrender.com
